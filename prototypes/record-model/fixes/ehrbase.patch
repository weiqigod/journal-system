+    /**
+     * ITS-REST 1.0.3 returns the latest version_uid in Location and ETag when a version precondition fails.
+     * The failed write has already rolled back; this lookup only reports the version the client must review.
+     */
+    private ResponseEntity<Map<String, String>> versionConflict(
+            HttpStatus status, UUID ehrId, UUID versionedObjectUid, String message) {
+        String latest = versionedObjectUid + "::" + systemService.getSystemId() + "::"
+                + compositionService.getLastVersionNumber(ehrId, versionedObjectUid);
+        HttpHeaders headers = new HttpHeaders();
+        headers.setLocation(createLocationUri(EHR, ehrId.toString(), COMPOSITION, latest));
+        headers.setETag("\"" + latest + "\"");
+        Map<String, String> body = new HashMap<>();
+        body.put("error", status.getReasonPhrase());
+        body.put("message", message);
+        return ResponseEntity.status(status).headers(headers).body(body);
+    }
